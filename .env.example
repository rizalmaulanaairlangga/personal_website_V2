# Supabase project URL for the shared portfolio database.
# Find this in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (public) key. Safe to expose to the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Emails allowed to sign in to the CMS. Comma separated.
# The address must also exist in Supabase Auth and in the cms_admins table
# created by supabase/migrations/20261021_cms_admin_policies.sql.
CMS_ADMIN_EMAILS=your-admin-address@example.com

# Supabase service_role key. SERVER ONLY. The CMS does not need it: every
# request runs as the signed-in administrator under Row Level Security.
# It is listed here only because some Supabase tooling expects it. Do not
# prefix it with NEXT_PUBLIC_ and do not expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
